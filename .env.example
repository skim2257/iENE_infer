# Example environment variables for docker-compose
# Copy this file to .env and update the paths

# Host paths - Update these to match your local paths
HOST_DATA_ROOT=/path/to/raw/dicom/dataset
HOST_PROCESSED_PATH=/path/to/processed/nifti/dataset
HOST_ORGANIZED_PATH=/path/to/reorganized/nifti/dataset
HOST_SEGMENTATION_PATH=/path/to/segmentation/outputs
HOST_OUTPUT_PATH=/path/to/final/predictions

# Model checkpoints - Download from Google Drive
HOST_IENE_MODELS=/path/to/iene/model/checkpoints
HOST_NNUNET_CHECKPOINT=/path/to/nnunet/checkpoint_best.pth